# Variables de entorno de Justa Apuesta. NUNCA subas los valores reales a GitHub.
# En tu PC las claves privadas van en backend/.env (ya está en .gitignore).

# --- Base de datos ---
# Con XAMPP no hace falta nada: el perfil "local" usa root sin contraseña en localhost:3306/justa_apuesta.
# DB_URL=jdbc:mariadb://localhost:3306/justa_apuesta
# DB_USER=root
# DB_PASSWORD=

# --- Seguridad ---
# En tu PC ya hay uno de desarrollo. Cadena aleatoria de al menos 32 caracteres.
# JWT_SECRET=

# --- Proveedor de datos (API-Football) ---
FOOTBALL_API_KEY=

# --- Sincronización manual: POST /api/admin/sync con la cabecera X-Admin-Key ---
ADMIN_SYNC_KEY=
